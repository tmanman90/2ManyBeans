# Environment (catch-all, then whitelist example)
.env*
!.env.example

# AI-generated images (not used by app)
generated_imgs/

# Capacitor Android project (not used)
android/

# Capacitor iOS project: tracked so native targets (widgets, Live Activities)
# live in git. Secrets, generated web assets and build output stay out.
**/GoogleService-Info*.plist
ios/DerivedData/
ios/**/DerivedData/
ios/**/xcuserdata/
ios/**/build/
ios/App/output/
ios/App/Pods/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/capacitor-cordova-ios-plugins/
.env*.local
.mcp.json
.codex/
.asset-archive/
.splash-backup-*/
.playwright-mcp/
*.png

# Launch deliverables + screenshot generator assets (tracked)
!docs/launch/screenshots/*.png
!docs/plans/mockups/**/*.png
!screenshot-generator/public/**/*.png
!public/*.png
!public/images/*.png
!public/images/**/*.png
!assets/*.png
!ios/App/App/Assets.xcassets/**/*.png
!docs/plans/mockups/**/*.png
# Unreferenced splash leftovers (Contents.json does not list them)
ios/App/App/Assets.xcassets/Splash.imageset/splash-2732x2732*.png
demo-recordings/

# U5 raw provider artifacts remain outside the committed evaluation evidence.
scripts/ruphus-eval/runs/raw/
docs/data/ruphus-model-eval/runs/raw/

# Raw QA run logs (receipts, manifests, failures) stay local; commit only the written summaries.
docs/qa/**/*.json
docs/qa/**/*.txt
!docs/qa/**/acceptance-index.json
!docs/qa/**/live-summary.json
