diff --git a/api/_lib/ruphusBrewEvidence.js b/api/_lib/ruphusBrewEvidence.js
new file mode 100644
index 0000000..15469d0
--- /dev/null
+++ b/api/_lib/ruphusBrewEvidence.js
@@ -0,0 +1,39 @@
+import { selectTimingMemory, timingContextFromRecipe } from '../../src/lib/brewTimingMemory.js';
+// Read-time projection only. Attempt.dose binds the saved source for optimistic
+// concurrency; snapshot is the recipe executed after a Brew once dose resize.
+const finite = value => typeof value === 'number' && Number.isFinite(value) && value > 0;
+const date = row => Date.parse(row.completedAt || row.createdAt || row.date || '') || 0;
+export function projectBrewEvidence(attempts = [], timingMemory = [], tastings = []) {
+  timingMemory = Array.isArray(timingMemory) ? timingMemory : [];
+  tastings = Array.isArray(tastings) ? tastings : [];
+  return attempts.filter(attempt => attempt && typeof attempt === 'object').map(attempt => {
+    const recipe = attempt.snapshot && typeof attempt.snapshot === 'object' && !Array.isArray(attempt.snapshot) ? attempt.snapshot : null;
+    if (!recipe) return { ...attempt }; // Historical flat records remain descriptive, never executable.
+    const dose = recipe.coffeeGrams ?? recipe.userCoffeeGrams ?? recipe.dose;
+    const water = recipe.waterGrams ?? recipe.water;
+    const timingContext = timingContextFromRecipe({ beanId: attempt.coffeeId, recipe, mode: recipe.mode || (recipe.isIced ? 'iced' : 'hot') });
+    // Reuse the timer's source/configuration/clock contract, then require the
+    // exact attempt and session. Validate separately so duplicate sessions
+    // with conflicting elapsed times remain ambiguous rather than deduped.
+    const timing = timingMemory.filter(event =>
+      event && attempt.id && event.attemptId === attempt.id
+      && (!attempt.sessionId || event.sessionId === attempt.sessionId)
+      && (!attempt.revisionId || event.revisionId === attempt.revisionId)
+      && event.doseGrams === dose
+      && finite(event.actualElapsedMs)
+      && selectTimingMemory([event], timingContext));
+    // Conflicting measurements are ambiguous: do not pick one by array order.
+    const elapsed = timing.length && new Set(timing.map(event => event.actualElapsedMs)).size === 1 ? timing[0].actualElapsedMs : null;
+    const feedback = tastings.filter(item => item && attempt.id && item.attemptId === attempt.id)
+      .map(item => item.notes || item.note).filter(value => typeof value === 'string').slice(0, 3);
+    const completed = attempt.status === 'completed';
+    return { ...attempt, dose, water, grind: recipe.grindSize?.setting ?? recipe.grind,
+      temperature: recipe.waterTemp?.celsius ?? recipe.temperature,
+      ratio: recipe.ratio, completed,
+      actualElapsedMs: completed ? elapsed : null,
+      drawdown: completed && elapsed != null ? `measured ${Math.floor(Math.round(elapsed / 1000) / 60)}:${String(Math.round(elapsed / 1000) % 60).padStart(2, '0')}` : null,
+      notes: feedback.length ? feedback.join(' | ') : attempt.notes || attempt.note,
+      feedback,
+    };
+  }).sort((a, b) => date(b) - date(a));
+}
diff --git a/api/_lib/ruphusSensoryConsistency.js b/api/_lib/ruphusSensoryConsistency.js
new file mode 100644
index 0000000..367ef1a
--- /dev/null
+++ b/api/_lib/ruphusSensoryConsistency.js
@@ -0,0 +1,27 @@
+// A narrow consistency check, not an extraction classifier. Match a direct
+// sensory-to-extraction claim, not unrelated words elsewhere in the sentence.
+// This deliberately does not attempt to grade every possible coffee inference.
+export function hasUnsupportedSensoryInference(value) {
+  if (typeof value !== 'string') return false;
+  const direction = String.raw`(?:over[ -]?extract\w*|under[ -]?extract\w*|too much extraction|more extraction|less extraction|(?:you\s+)?(?:must\s+)?grind(?:ing)? (?:finer|coarser))`;
+  const subject = String.raw`(?:sharpness|sourness|(?:sharp|sour) (?:cup|coffee))`;
+  const direct = new RegExp(String.raw`\b${subject}\s+(?:(?:alone|by itself)\s+)?(?:means?|proves?|confirms?)\s+(?:(?:that|it(?:'s| is)|the cup is|you have)\s+)*${direction}\b`, 'i');
+  const reversal = /\b(?:sharpness|sourness|sharp|sour)(?:\s+(?:cup|coffee|alone))?\s*,?\s*(?:(?:that|it)\s+)?points?\s+away\s+from\s+(?:more|higher|increasing)\s+extraction\b/i;
+  const conditionalDiagnosis = new RegExp(String.raw`\b(?:turns?|tastes?|is)\s+(?:sharp|sour)\s*,\s*(?:it|that|the cup)\s+(?:must be|is definitely|is certainly)\s+${direction}\b`, 'i');
+  const rejectedPrefix = /(?:\b(?:do not|don[’']t|never|avoid)\s+(?:assum(?:e|ing)|say(?:ing)?|claim(?:ing)?|conclud(?:e|ing))|\b(?:wrong|incorrect|misleading|unjustified)\s+to\s+(?:say|claim|assume|conclude)|\bnot\s+(?:true|established)\s+that)\s+(?:that\s+)?(?:[“"‘']\s*)?(?:(?:a|the)\s+)?$/i;
+  const rejectedSuffix = /^[”"’']?\s+(?:is|would be)\s+(?:wrong|incorrect|unsupported|unjustified|not supported)\b/i;
+  return value.split(/(?<=[.!?])\s+/u).some(sentence => {
+    if (sentence.trim().endsWith('?')) return false;
+    return [direct, reversal, conditionalDiagnosis].some(pattern => {
+      // Check rejection at each matched claim, so an unrelated negation or
+      // qualification cannot excuse a second categorical assertion.
+      for (const match of sentence.matchAll(new RegExp(pattern.source, 'gi'))) {
+        if (!rejectedPrefix.test(sentence.slice(0, match.index))
+          && !rejectedSuffix.test(sentence.slice(match.index + match[0].length))) return true;
+      }
+      return false;
+    });
+  });
+}
+
+export const SENSORY_UNCERTAINTY_CORRECTION = 'Sharpness alone does not establish extraction direction or rule out more extraction. Distinguish sour acidity from bitterness or a drying sensation; describe a bounded test or ask what sharp means. Do not invent a reported sensation or change the recipe merely to fix the explanation.';
