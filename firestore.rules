rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document.
    //
    // Split into create vs update because `resource.data` is null on create
    // and the diff() guard blows up. The create rule must explicitly forbid
    // any client-supplied `subscription` or `fellow` field; otherwise a fresh
    // sign-in could inject `subscription.status = 'active'` and bypass the
    // entire RC entitlement check.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'signUpProvider',
          'username', 'createdAt', 'lastLoginAt', 'onboardingComplete',
          'marketingConsent', 'marketingConsentDate', 'preferences'
        ])
        // Belt-and-suspenders: even if the keys() check above changes,
        // the create path can never include subscription or fellow.
        && !request.resource.data.keys().hasAny(['fellow', 'subscription'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && (request.resource.data.username == null
            || (request.resource.data.username is string
                && request.resource.data.username.size() >= 3
                && request.resource.data.username.size() <= 30
                && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')));

      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'signUpProvider',
          'username', 'createdAt', 'lastLoginAt', 'onboardingComplete',
          'marketingConsent', 'marketingConsentDate', 'preferences',
          'fellow', 'subscription'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && (request.resource.data.username == null
            || (request.resource.data.username is string
                && request.resource.data.username.size() >= 3
                && request.resource.data.username.size() <= 30
                && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')))
        // Client cannot modify fellow.* or subscription.* on update either.
        // affectedKeys() reports the top-level key for any nested mutation,
        // so this catches `subscription.freeUsage` resets too.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fellow', 'subscription']));
    }

    // Fellow secrets: Admin SDK only, client cannot read or write
    match /users/{userId}/secrets/{secretId} {
      allow read, write: if false;
    }

    // Beans subcollection. Scoped rule -- size cap + required ownership,
    // no arbitrary garbage bags of data that could drive up Firestore bill.
    // 100KB per bean doc is generous but below the 1MB Firestore per-doc
    // limit and catches accidental base64 image bloat early.
    match /users/{userId}/beans/{beanId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.size() <= 100;  // max 100 top-level fields
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Tastings subcollection. Same shape, smaller per-doc budget.
    match /users/{userId}/tastings/{tastingId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.size() <= 100;  // max 100 top-level fields
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // No catch-all subcollection rule. Any future server-managed collection
    // (e.g. usage ledgers, audit logs) is reachable only via Admin SDK and
    // explicitly denied to clients by default. If a new client-writable
    // subcollection is added, declare an explicit `match` block above.

    // Email subscriber list for marketing
    match /emailList/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'signUpDate', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
    }
  }
}
