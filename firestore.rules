rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'signUpProvider',
          'username', 'createdAt', 'lastLoginAt', 'onboardingComplete',
          'marketingConsent', 'marketingConsentDate', 'preferences',
          'fellow', 'subscription'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && (request.resource.data.username == null
            || (request.resource.data.username is string
                && request.resource.data.username.size() >= 3
                && request.resource.data.username.size() <= 30
                && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')))
        // Client cannot modify fellow.* or subscription.* fields -- both are
        // managed exclusively by the server (Admin SDK via the Fellow encrypt
        // flow and the RevenueCat webhook + metered gate). Listing them in
        // the whitelist above means CLIENT writes can safely PASS THROUGH
        // existing values, but this diff check prevents clients from
        // MUTATING them (self-upgrading to Pro, disconnecting Fellow, etc).
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fellow', 'subscription']));
    }

    // Fellow secrets: Admin SDK only, client cannot read or write
    match /users/{userId}/secrets/{secretId} {
      allow read, write: if false;
    }

    // Beans subcollection. Scoped rule -- size cap + required ownership,
    // no arbitrary garbage bags of data that could drive up Firestore bill.
    // 100KB per bean doc is generous but below the 1MB Firestore per-doc
    // limit and catches accidental base64 image bloat early.
    match /users/{userId}/beans/{beanId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.size() <= 100;  // max 100 top-level fields
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Tastings subcollection. Same shape, smaller per-doc budget.
    match /users/{userId}/tastings/{tastingId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.size() <= 100;  // max 100 top-level fields
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Any other user-scoped subcollection (usage counters, preferences, etc.)
    // -- owner-only, excludes secrets via the more-specific rule above.
    match /users/{userId}/{collection}/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && collection != 'secrets';
    }
    // Deeper nesting fallback for any future nested subcollections.
    match /users/{userId}/{collection}/{document}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && collection != 'secrets';
    }

    // Email subscriber list for marketing
    match /emailList/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'signUpDate', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
    }
  }
}
